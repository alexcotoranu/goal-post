extends layout

block content
  .dashboard

    //- QUICK ADD
    form.quick-add(action='/tasks/quick', method='post')
      input(type='hidden', name='redirectTo', value='/')
      input.quick-add-input(type='text', name='title', placeholder='Add a task... just type and press Enter', autocomplete='off', autofocus)
      input.quick-add-prefix(type='text', name='catprefix', placeholder='Group', list='prefix-list', autocomplete='off')
      datalist#prefix-list
        each p in prefixes
          option(value=p)
      button.quick-add-btn(type='submit') Add

    //- TODAY'S FOCUS
    section.focus-section
      h2.section-title
        span.section-icon ◎
        | Today's Focus
      if focusTasks.length === 0
        p.empty-state You're on track — nothing urgent today.
      else
        ul.focus-list
          each item in focusTasks
            li.focus-item(class='urgency-' + item.urgency)
              .focus-left
                span.urgency-badge(class='badge-' + item.urgency)
                  if item.urgency === 'overdue'
                    | OVERDUE
                  else if item.urgency === 'today'
                    | TODAY
                  else if item.urgency === 'soon'
                    | SOON
                  else
                    | HIGH PRI
                a.focus-title(href='/tasks/' + item.task._id)
                  if item.task.catprefix && item.task.idincat
                    span.focus-id= item.task.catprefix + '-' + String(item.task.idincat).padStart(3,'0') + ' '
                  = item.task.title
              .focus-right
                if item.task.target
                  span.focus-date= item.task.target.toISOString().substring(0,10)
                if item.task.progress
                  .focus-progress
                    .mini-bar
                      .mini-fill(style='width:' + item.task.progress + '%')
                    span.mini-pct= item.task.progress + '%'

    //- GROUP CARDS
    section.groups-section
      h2.section-title
        span.section-icon ▦
        | Task Groups
      if groups.length === 0
        p.empty-state No tasks yet — add your first one above.
      else
        .group-grid
          each group in groups
            a.group-card(href='/tasks/group/' + group.prefix, class=group.overdue > 0 ? 'has-overdue' : group.focus > 0 ? 'has-focus' : '')
              .group-prefix= group.prefix
              .group-stats
                span.stat
                  span.stat-num= group.total - group.done
                  span.stat-label  open
                span.stat
                  span.stat-num= group.done
                  span.stat-label  done
                if group.overdue > 0
                  span.stat.stat-overdue
                    span.stat-num= group.overdue
                    span.stat-label  overdue
              .group-bar
                span.group-bar-fill(style='width:' + (group.total > 0 ? Math.round(group.done / group.total * 100) : 0) + '%')
              .group-pct= group.total > 0 ? Math.round(group.done / group.total * 100) + '% done' : '—'
