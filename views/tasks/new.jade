extends ../layout

block content
  .form-page
    .form-header
      a.back-link(href='/') ← Dashboard
      h1 New Task

    form.task-form(action='/tasks', method='post', enctype='multipart/form-data')

      .form-row
        .form-field.field-grow
          label Title
          input(type='text', name='title', placeholder='What needs to be done?', required, autofocus)
        .form-field.field-narrow
          label Group
          input(type='text', name='catprefix', placeholder='e.g. PRJ', list='prefix-list', autocomplete='off')
          datalist#prefix-list
            each p in prefixes
              option(value=p)
          p.field-hint ID auto-generated

      .form-field
        label Description
        textarea(name='description', rows='3', placeholder='More detail, context, links...')

      .form-row
        .form-field
          label Status
          select(name='status')
            option(value='backlog') Backlog
            option(value='todo') To Do
            option(value='in-progress') In Progress
            option(value='review') Review
            option(value='done') Done

        .form-field
          label Priority
          select(name='priority')
            option(value='') — None
            option(value='1') 1 · Low
            option(value='2') 2 · Medium
            option(value='3') 3 · High
            option(value='4') 4 · Critical
            option(value='5') 5 · Blocker

        .form-field
          label Difficulty
          select(name='difficulty')
            option(value='') — None
            option(value='easy') Easy
            option(value='medium') Medium
            option(value='hard') Hard

      .form-row
        .form-field
          label Target Date
          input(type='date', name='target')

        .form-field
          label Progress (%)
          input(type='number', name='progress', min='0', max='100', placeholder='0')

      .form-field
        label Attachment
        input(type='file', name='img')

      .form-actions
        button(type='submit') Create Task
        a.btn-cancel(href='/') Cancel
