extends ../layout

block content
  .form-page
    .form-header
      a.back-link(href='/tasks/' + task._id) ← Back
      h1
        span.task-id-badge= (task.catprefix || '?') + '-' + (task.idincat ? padId(task.idincat) : '???')
        |  Edit Task

    form.task-form(action='/tasks/' + task._id + '/edit', method='post', enctype='multipart/form-data')
      input(type='hidden', name='_method', value='PUT')

      .form-row
        .form-field.field-grow
          label Title
          input(type='text', name='title', value=task.title || '', required)
        .form-field.field-narrow
          label Group
          input(type='text', name='catprefix', value=task.catprefix || '', list='prefix-list', autocomplete='off')
          datalist#prefix-list
            each p in prefixes
              option(value=p)

      .form-field
        label Description
        textarea(name='description', rows='3')= task.description || ''

      .form-row
        .form-field
          label Status
          select(name='status')
            each s in ['backlog','todo','in-progress','review','done']
              if task.status === s
                option(value=s, selected) #{s}
              else
                option(value=s) #{s}

        .form-field
          label Priority
          select(name='priority')
            option(value='', selected=(task.priority == null)) — None
            each p in [1,2,3,4,5]
              if task.priority == p
                option(value=p, selected) #{p} · #{['Low','Medium','High','Critical','Blocker'][p-1]}
              else
                option(value=p) #{p} · #{['Low','Medium','High','Critical','Blocker'][p-1]}

        .form-field
          label Difficulty
          select(name='difficulty')
            option(value='', selected=!task.difficulty) — None
            each d in ['easy','medium','hard']
              if task.difficulty === d
                option(value=d, selected) #{d}
              else
                option(value=d) #{d}

      .form-row
        .form-field
          label Target Date
          input(type='date', name='target', value=targetStr)

        .form-field
          label Progress (%)
          input(type='number', name='progress', min='0', max='100', value=task.progress || 0)

      .form-field
        label Replace Attachment
        input(type='file', name='img')
        if task.img
          p.field-hint Current: #{task.img}

      .form-actions
        button(type='submit') Save Changes
        a.btn-cancel(href='/tasks/' + task._id) Cancel
