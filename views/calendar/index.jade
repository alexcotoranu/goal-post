extends ../layout

block content
  .cal-page

    .cal-header
      .cal-nav
        a(href='/calendar/' + prevYear + '/' + prevMonth) ←
      h2.cal-month-title= monthName + ' ' + year
      .cal-nav
        a(href='/calendar/' + nextYear + '/' + nextMonth) →

    .cal-grid
      each d in dayNames
        .cal-day-header= d

      each week in weeks
        each cell in week
          if cell === null
            .cal-day.cal-empty
          else
            .cal-day(class=cell.isToday ? 'cal-today' : '')
              .cal-day-num= cell.day
              each task in cell.tasks
                a.cal-chip(
                  href='/tasks/' + task._id,
                  class=task.completed ? 'chip-done' : '',
                  title=(task.catprefix || '') + (task.idincat ? '-' + String(task.idincat).padStart(3,'0') : '') + ' ' + (task.title || '')
                )
                  if task.catprefix && task.idincat
                    = task.catprefix + '-' + String(task.idincat).padStart(3,'0') + ' '
                  = task.title
